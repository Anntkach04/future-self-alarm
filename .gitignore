# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native (generated by expo prebuild / run:ios)
ios/
android/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# music beds — keep local, do not commit large audio
server/assets/beds/*.mp3
server/assets/beds/*.m4a
server/assets/beds/*.wav
server/assets/beds/*.ogg
# Our own ElevenLabs-generated sounds/music are small and ours: keep them in git
!server/assets/beds/sound-*.mp3
!server/assets/beds/music-*.mp3
# CC0 music beds (docs/music/SOURCES.md): small enough, keep every laptop in sync
!server/assets/beds/soft-calm.m4a
!server/assets/beds/bali-morning.m4a
!server/assets/beds/yoga-air.m4a
!server/assets/beds/warm-earth.m4a

# local user store when DATABASE_URL is unset
server/data/

# local tooling
.claude/
