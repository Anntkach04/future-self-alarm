# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
# Paid plan is required for Instant Voice Cloning.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Best available TTS for clones (account has v4). Fallbacks are automatic:
# eleven_v4 → eleven_multilingual_v2 → eleven_v3 → eleven_turbo_v2_5
ELEVENLABS_TTS_MODEL=eleven_v4
ELEVENLABS_LANGUAGE=en
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_192

# Likeness defaults (0–1). style=0 keeps it from sounding “acted”.
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY=0.8
# ELEVENLABS_STYLE=0
# ELEVENLABS_SPEED=1

# Leave STS off for likeness (set true only to experiment).
# ELEVENLABS_STS=false
# ELEVENLABS_STS_MODEL=eleven_multilingual_sts_v2

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MOOD_MODEL=gpt-4o-mini

VOICE_API_PORT=8787
EXPO_PUBLIC_API_URL=http://localhost:8787
