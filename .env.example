# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
# Paid plan is required for Instant Voice Cloning.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Best available TTS for clones (account has v4). Fallbacks are automatic:
# eleven_v4 → eleven_multilingual_v2 → eleven_v3 → eleven_turbo_v2_5
ELEVENLABS_TTS_MODEL=eleven_v4
ELEVENLABS_LANGUAGE=en
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_192

# Likeness defaults (0–1). style=0 keeps it from sounding “acted”.
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY=0.8
# ELEVENLABS_STYLE=0
# ELEVENLABS_SPEED=1

# Leave STS off for likeness (set true only to experiment).
# ELEVENLABS_STS=false
# ELEVENLABS_STS_MODEL=eleven_multilingual_sts_v2

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MOOD_MODEL=gpt-4o-mini

VOICE_API_PORT=8787

# Local Mac / LAN (dev):
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8787
#
# Production (Railway HTTPS) - bake into the Release build:
# EXPO_PUBLIC_API_URL=https://YOUR-SERVICE.up.railway.app
EXPO_PUBLIC_API_URL=http://localhost:8787

# --- Backend auth (server) ---
# Random secret. When set, clone/TTS/generate require Sign in with Apple.
# JWT_SECRET=replace_with_long_random_string
#
# Must match iOS bundle id (app.json → ios.bundleIdentifier)
# APPLE_CLIENT_ID=com.anonymous.future-self-alarm
#
# JWT lifetime (default 90d). Soft reauth banner if expired; Home stays local.
# APP_JWT_TTL=90d
#
# Soft in-app update banner when client version is below this:
# MIN_APP_VERSION=1.0.1
# FORCE_APP_VERSION=1.0.0
# APP_STORE_URL=https://apps.apple.com/app/idYOUR_ID
#
# Optional Postgres (Railway Postgres plugin). Without it, users live in server/data/.
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# RevenueCat public Apple SDK key (App Store monthly + 7-day intro trial)
# EXPO_PUBLIC_REVENUECAT_IOS=appl_xxxxxxxx

# Legal pages default to {EXPO_PUBLIC_API_URL}/privacy and /terms
# EXPO_PUBLIC_PRIVACY_URL=https://YOUR-SERVICE.up.railway.app/privacy
# EXPO_PUBLIC_TERMS_URL=https://YOUR-SERVICE.up.railway.app/terms
# Support inbox (use +tag so sister can filter): name+futureself@gmail.com
# EXPO_PUBLIC_SUPPORT_EMAIL=name+futureself@gmail.com
# SUPPORT_EMAIL=name+futureself@gmail.com

