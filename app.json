{
  "expo": {
    "name": "Future Self Alarm",
    "slug": "future-self-alarm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "deploymentTarget": "26.1",
      "buildNumber": "26",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Future Self to record your voice for cloning.",
        "NSSpeechRecognitionUsageDescription": "Allow Future Self to listen while you read the script aloud.",
        "NSLocalNetworkUsageDescription": "On a developer Mac, Future Self can talk to a local voice server. Production builds use a secure HTTPS API.",
        "NSAlarmKitUsageDescription": "Future Self uses alarms to wake you with your own voice.",
        "NSBonjourServices": [
          "_http._tcp."
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIBackgroundModes": [
          "audio",
          "fetch"
        ]
      },
      "bundleIdentifier": "com.anonymous.future-self-alarm"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Future Self to record your voice for cloning."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Future Self to record your voice for cloning.",
          "speechRecognitionPermission": "Allow Future Self to listen while you read the script aloud."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/fs_fallback.caf"
          ],
          "mode": "production"
        }
      ],
      "./plugins/withLocalNotificationsOnly.js",
      "./plugins/withAlarmKit.js",
      "./plugins/withIosLibrarySounds.js",
      "@react-native-community/datetimepicker"
    ],
    "newArchEnabled": true
  }
}
